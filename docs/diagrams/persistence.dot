digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Session save and load";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Verified source and score" -> "v2 bytes" [label="embedded source"];
  "v2 bytes" -> "Sibling temporary file" [label="exclusive creation"];
  "Sibling temporary file" -> "Session path" [label="sync and rename"];
  "v1 session" -> "Current in-memory model" [label="one pass"];
  "Session path" -> "Current in-memory model" [label="bounded parse"];
  "Current in-memory model" -> "Compile and schedule" [label="device-independent"];
}
