digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Audio and control ownership";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Control producer" -> "Event ring" [label="release write"];
  "Event ring" -> "Audio consumer" [label="acquire read"];
  "Audio consumer" -> "Trace ring" [label="release record"];
  "Trace ring" -> "Control producer" [label="acquire record"];
  "Audio consumer" -> "DSP state" [label="exclusive mutation"];
}
