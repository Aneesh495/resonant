digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Partitioned convolution hop";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "P input samples" -> "2P FFT" [label="zero padding"];
  "2P FFT" -> "Spectrum history" [label="advance ring"];
  "Impulse partitions" -> "Spectrum product sum" [label="prepared on control"];
  "Spectrum history" -> "Spectrum product sum" [label="reverse-age pairs"];
  "Spectrum product sum" -> "Inverse FFT" [label="frequency bins"];
  "Inverse FFT" -> "P ready samples" [label="overlap-add"];
  "Inverse FFT" -> "Saved overlap" [label="retain second half"];
}
