digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Package lifecycle";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Control-owned candidate" -> "Pending mailbox" [label="exchange"];
  "Pending mailbox" -> "Active package" [label="callback boundary"];
  "Active package" -> "Fading package" [label="install successor"];
  "Fading package" -> "Retired mailbox" [label="128 samples complete"];
  "Retired mailbox" -> "Control destruction" [label="last audio access already ended"];
  "Pending mailbox" -> "Control destruction" [label="superseded before install"];
}
