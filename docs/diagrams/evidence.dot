digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Evidence lineage";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Trusted source commit" -> "Frozen fixture" [label="source SHA-256"];
  "Frozen fixture" -> "Device or offline run" [label="record actual command"];
  "Device or offline run" -> "Manifested raw records" [label="retain bytes"];
  "Manifested raw records" -> "Independent verifier" [label="recompute time and spectra"];
  "Trusted source commit" -> "Independent verifier" [label="trusted inputs and bounded replay"];
}
