digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Compiler passes";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Source bytes" -> "Spanned declarations" [label="lexer and parser"];
  "Spanned declarations" -> "Current-frame graph" [label="resolve names"];
  "Current-frame graph" -> "Typed order" [label="topological sort"];
  "Typed order" -> "Reachable values" [label="fold and remove dead values"];
  "Reachable values" -> "Physical registers" [label="last use"];
  "Physical registers" -> "Verified bytecode" [label="independent check"];
}
