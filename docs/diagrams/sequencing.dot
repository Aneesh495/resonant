digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Timeline scheduling";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "Score tick" -> "Rational tempo integrator" [label="tempo intervals"];
  "Rational tempo integrator" -> "Absolute sample" [label="round once"];
  "MIDI byte stream" -> "Timestamped event" [label="running status"];
  "Absolute sample" -> "Timestamped event" [label="score payload"];
  "Timestamped event" -> "Block offset" [label="monotonic FIFO"];
  "Block offset" -> "VM event" [label="apply before sample"];
}
