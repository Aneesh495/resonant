digraph resonant {
  rankdir=LR;
  bgcolor="#101820";
  label="Register lifetimes";
  labelloc=t; fontcolor="#d9e7ec"; fontname="Helvetica";
  node [shape=box style="rounded,filled" fillcolor="#1e303d" color="#426474" fontcolor="#d9e7ec" fontname="Helvetica"];
  edge [color="#55baad" fontcolor="#acc3ce" fontname="Helvetica" fontsize=10];
  "r0 control A at pc 0" -> "pc 3 reads r0" [label="last use A"];
  "pc 3 reads r0" -> "r0 audio B at pc 4" [label="storage reusable"];
  "r0 audio B at pc 4" -> "pc 9 output" [label="last use B"];
  "r1 delay source at pc 2" -> "pc 8 delay commit" [label="keep live through epilogue"];
}
